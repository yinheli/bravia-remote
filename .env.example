# Copy this file to .env and edit it. Bun loads .env automatically.
#
# Required: the TV's LAN address.
BRAVIA_TV=http://192.0.2.10

# Defaults are shown commented out.
# HOST=127.0.0.1
# To expose on the LAN, prefer HOST=<LAN IP>; 0.0.0.0 also allows DNS rebinding.
# PORT=8765

# Authentication (default: token).
# If BRAVIA_TOKEN is unset, a 256-bit token is generated in
# BRAVIA_TOKEN_FILE with mode 0600; enter it in the web UI.
# Prefer a pinned token when running multiple hosts or after redeploys.
# BRAVIA_AUTH_MODE=token
# BRAVIA_TOKEN=replace-with-at-least-4-non-whitespace-chars
# BRAVIA_TOKEN_FILE=/home/you/.config/bravia-remote/.bravia_token

# HTTP Basic is an alternative to token mode.
# BRAVIA_BASIC_USER=admin
# BRAVIA_BASIC_PASSWORD=replace-with-at-least-8-chars

# TV pairing credentials and optional overrides.
# BRAVIA_PSK=your-tv-pre-shared-key
# BRAVIA_CLIENT_ID overrides the client id saved in the auth file; when unset,
# the paired id is reused (or bravia-remote for a new auth file).
# BRAVIA_CLIENT_ID=bravia-remote
# BRAVIA_AUTH_FILE=/home/you/.config/bravia-remote/auth.json

# Optional network-adb screenshot support.
# Enabling network adb exposes the TV debug bridge on the LAN; see SECURITY.md.
# BRAVIA_ADB=adb
# BRAVIA_TIMEOUT_MS=4000
# BRAVIA_SCREEN_TIMEOUT_MS=9000

# Only needed when TLS is terminated at a reverse proxy.
# BRAVIA_PUBLIC_ORIGIN=https://remote.example.com

# Extra app buttons: comma-separated Name=uri pairs.
# BRAVIA_APPS=MyApp=com.example.app,Other=com.example.other
